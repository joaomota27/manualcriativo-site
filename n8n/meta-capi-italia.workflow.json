    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst rawPayload = input.body?.payload ?? input.payload;\nif (!rawPayload) throw new Error('Payload ausente');\nconst event = typeof rawPayload === 'string' ? JSON.parse(rawPayload) : rawPayload;\nconst allowedEvents = new Set(['PageView', 'InitiateCheckout']);\nif (!allowedEvents.has(event.event_name)) throw new Error('Evento nao permitido');\nif (!event.event_id || !event.event_time || !event.event_source_url || !event.tracking_id) throw new Error('Campos obrigatorios ausentes');\nconst headers = input.headers ?? {};\nconst forwardedFor = headers['x-forwarded-for'] ?? headers['x-real-ip'] ?? '';\nconst clientIp = String(forwardedFor).split(',')[0].trim();\nconst userData = {\n  fbc: event.user_data?.fbc || undefined,\n  fbp: event.user_data?.fbp || undefined,\n  client_user_agent: event.user_agent || headers['user-agent'] || undefined,\n  client_ip_address: clientIp || undefined,\n};\nObject.keys(userData).forEach((key) => { if (!userData[key]) delete userData[key]; });\nreturn [{ json: {\n  tracking_id: String(event.tracking_id),\n  fbc: userData.fbc ?? '',\n  fbp: userData.fbp ?? '',\n  client_ip_address: userData.client_ip_address ?? '',\n  client_user_agent: userData.client_user_agent ?? '',\n  event_source_url: String(event.event_source_url),\n  updated_at: new Date().toISOString(),\n  capi: { data: [{\n    event_name: event.event_name,\n    event_time: Number(event.event_time),\n    event_id: String(event.event_id),\n    action_source: 'website',\n    event_source_url: String(event.event_source_url),\n    user_data: userData,\n    custom_data: event.custom_data ?? {},\n  }] },\n} }];"
      },
